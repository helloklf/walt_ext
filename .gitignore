# intermediate build artifacts (regenerate via common/build.sh)
out/
*.o
*.zip

# large BTF dumps — regenerate from device (see materials/README.md)
btf_raw.txt
btf_c.h
vmlinux_btf
*.btf

# runtime logs
boot.log

# compare/ large raw dumps — regenerate via tools/dump_device.sh
compare/*/vendor_boot.img
compare/*/ramdisk
compare/*/ramdisk.cpio

# staged server artifacts — regenerate via build-all.sh
kernel_modules/

# universal KSU module — regenerate via build-all.sh
dist/

